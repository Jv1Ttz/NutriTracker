# Sincronizacao entre aparelhos (opcional).
#
# Sem estas variaveis o app funciona igual, so offline: a secao de conta
# some dos Ajustes e nada e enviado para lugar nenhum.
#
# Os valores estao no painel do Supabase, em Project Settings > API Keys.
# A chave publicavel e feita para ficar no bundle do navegador - quem protege
# os dados e a RLS do banco, nao o segredo da chave.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
